# Nea backend — single env file for node-api (:NODE_API_PORT) and ai-service (:RISK_SERVICE_PORT).
# Copy to `.env` in this folder:  cp .env.example .env
# Do not commit `.env`.

# --- Database (Supabase Postgres) — used by node-api / Prisma ---
# Prefer the connection pooler (IPv4) on port 6543:
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# --- Auth ---
# Google OAuth (optional). Leave empty to disable POST /api/auth/oauth/google (returns 501).
GOOGLE_OAUTH_CLIENT_ID=""
# Firebase: place serviceAccountKey.json in node-api/ (gitignored) — not an env var.

# --- Optional: S3 voice-recording archival (node-api) ---
# Leave AWS_S3_BUCKET empty to skip.
AWS_S3_BUCKET=""
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# --- Groq (chat LLM) — node-api ---
GROQ_API_KEY="gsk_..."
GROQ_CHAT_MODEL="openai/gpt-oss-120b"
GROQ_STT_MODEL="whisper-large-v3"

# --- Google Cloud Speech-to-Text + Text-to-Speech — node-api ---
GOOGLE_API_KEY="AIza..."
GOOGLE_STT_LANGUAGE="en-IN"
TTS_DEFAULT_VOICE="en-IN-Wavenet-A"

# --- node-api server ---
NODE_API_PORT=4000
NODE_ENV=development
CORS_ORIGIN="*"

# --- Internal Node ↔ Python risk-classifier ---
AI_SERVICE_URL="http://localhost:8000"
INTERNAL_API_KEY="change-me-shared-secret-between-node-and-python"

# --- ai-service (ML risk classifier only) ---
RISK_SERVICE_PORT=8000
