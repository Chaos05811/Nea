{
  "name": "nea-core-api",
  "version": "0.2.0",
  "private": true,
  "description": "Nea (SIH 2026, PSID 198) — core API: users, sessions, messages, memory, DB (Postgres/Supabase via Prisma), optional S3 audio archival. Plain HTTP — callers pass userId; no JWT/auth middleware. MVP scope — see README.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
    "@prisma/client": "^6.1.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^14.4.0",
    "form-data": "^4.0.1",
    "google-auth-library": "^9.15.0",
    "groq-sdk": "^1.6.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "msedge-tts": "^2.0.7",
    "multer": "^1.4.5-lts.2",
    "node-cron": "^4.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
