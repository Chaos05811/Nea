# --- Database (Supabase Postgres) ---
# IMPORTANT: db.<ref>.supabase.co is IPv6-only on new Supabase projects.
# If you deploy anywhere IPv4-only (Render/Railway/most laptops without IPv6),
# use the connection pooler string from Supabase dashboard -> Settings -> Database
# -> Connection Pooling ("Transaction" mode, port 6543) instead — it looks like:
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:<nea123456@qwer>@db.<ref>.supabase.co:5432/postgres?sslmode=require"

# --- Auth ---
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Google OAuth (Sign in with Google from the Expo app). Leave unset to disable the
# /api/auth/oauth/google route (returns 501) — email/password auth keeps working either way.
# Get one at https://console.cloud.google.com/apis/credentials (OAuth client ID, type "Web application"
# even for a mobile app — the frontend gets the id_token via expo-auth-session/Google Sign-In).
GOOGLE_OAUTH_CLIENT_ID=""

# --- Optional: S3 voice-recording archival ---
# Leave AWS_S3_BUCKET unset to skip entirely (default for the demo).
AWS_S3_BUCKET=""
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# --- Groq (chat LLM + Whisper STT) ---
# Get a free key at https://console.groq.com
GROQ_API_KEY="gsk_..."
GROQ_CHAT_MODEL="openai/gpt-oss-120b"
GROQ_STT_MODEL="whisper-large-v3"

# --- TTS (msedge-tts — free, no key needed) ---
TTS_DEFAULT_VOICE="en-IN-NeerjaNeural"

# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN="*"

# --- Internal service-to-service auth (Node <-> Python risk-classifier service) ---
# ai-service is now ONLY the ML risk classifier (see backend/CLAUDE.md).
AI_SERVICE_URL="http://localhost:8000"
INTERNAL_API_KEY="change-me-shared-secret-between-node-and-python"
