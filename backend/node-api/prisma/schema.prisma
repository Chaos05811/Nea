// Nea — core-api database schema
// Owns the schema. The Python ai-service reads (and writes capsules/facts) against
// the SAME database using SQLAlchemy models that mirror this file — see ai-service/app/core/db_models.py.
// Run migrations from here only (`npm run prisma:migrate`) to keep one source of truth.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?  @map("password_hash") // null for OAuth-only accounts (see googleId / firebaseUid)
  googleId     String?  @unique @map("google_id") // set when the account signed up/in via Google OAuth
  firebaseUid  String?  @unique @map("firebase_uid") // set when the account authenticates via Firebase Auth
  displayName  String?  @map("display_name")
  ageGroup     String?  @map("age_group") // "child" | "teen" | "adult" | "senior" — coarse band only, drives persona adaptation
  language     String   @default("en") @map("language") // BCP-47, e.g. "en", "hi" — for Bhashini/Groq prompt localisation
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions    Session[]
  messages    Message[]
  facts       FactMemory[]
  capsules    Capsule[]
  riskEvents  RiskEvent[]
  traits      UserTrait[]
  contacts    TrustedContact[]
  checkIns    CheckIn[]

  @@map("users")
}

// Opt-in trusted-contact escalation (feature #6 in the design doc)
model TrustedContact {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  relation  String?
  phone     String?
  email     String?
  consented Boolean  @default(false) // must be explicitly opted in before any handoff uses this contact
  createdAt DateTime @default(now()) @map("created_at")

  @@map("trusted_contacts")
}

// ---------------------------------------------------------------------------
// Conversation
// ---------------------------------------------------------------------------

enum Modality {
  text
  voice
  video
  isl
}

model Session {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  modality  Modality  @default(text)
  title     String?
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  messages Message[]

  @@index([userId, startedAt])
  @@map("sessions")
}

enum Role {
  user
  assistant
  system
}

enum RiskLevel {
  none
  low
  medium
  high
  critical
}

model Message {
  id        String    @id @default(uuid())
  sessionId String    @map("session_id")
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  content   String
  modality  Modality  @default(text)
  riskLevel RiskLevel @default(none) @map("risk_level")
  brain     String?   // which "brain" produced this reply: conversation | psychological | coaching | companion
  createdAt DateTime  @default(now()) @map("created_at")

  riskEvents RiskEvent[]

  @@index([sessionId, createdAt])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Memory layer
// ---------------------------------------------------------------------------

// Versioned fact log — permanent, never silently overwritten (valid_to is set instead of deleting).
// This is where risk-critical / identity facts live, per the "decaying traits vs. permanent facts" design.
model FactMemory {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  factKey         String    @map("fact_key") // e.g. "lives_with", "exam_stress_trigger"
  factValue       String    @map("fact_value")
  sourceMessageId String?   @map("source_message_id")
  validFrom       DateTime  @default(now()) @map("valid_from")
  validTo         DateTime? @map("valid_to") // null = currently valid
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([userId, factKey, validTo])
  @@map("fact_memory")
}

// Decaying personality/trait scores (mood tendencies, communication style, etc.)
model UserTrait {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trait     String
  score     Float    @default(0) // -1..1, decays toward 0 over time via ai-service job
  decayRate Float    @default(0.02) @map("decay_rate")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, trait])
  @@map("user_traits")
}

// Weekly (or 5-conversation) hierarchical memory consolidation — the capsule design (H-MEM inspired).
model Capsule {
  id              String                 @id @default(uuid())
  userId          String                 @map("user_id")
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStart     DateTime               @map("period_start")
  periodEnd       DateTime               @map("period_end")
  summary         String
  conversationCount Int                  @default(0) @map("conversation_count")
  closedReason    String?                @map("closed_reason") // "7_days" | "5_conversations"
  createdAt       DateTime               @default(now()) @map("created_at")

  @@index([userId, periodStart])
  @@map("capsules")
}

// Daily self-reported mood check-in — powers the dashboard's check-in row and weekly pattern.
// One per user per calendar day (upserted); this is real, user-entered data, not derived/inferred.
enum Mood {
  good
  okay
  low
  stressed
}

model CheckIn {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood      Mood
  day       DateTime @map("day") @db.Date // calendar day this check-in belongs to (server-local date)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, day])
  @@index([userId, day])
  @@map("check_ins")
}

// ---------------------------------------------------------------------------
// Safety
// ---------------------------------------------------------------------------

model RiskEvent {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId           String?   @map("message_id")
  message             Message?  @relation(fields: [messageId], references: [id], onDelete: SetNull)
  riskLevel           RiskLevel @map("risk_level")
  signal              String    // short description of what triggered detection
  resourcesOffered    Json?     @map("resources_offered") // e.g. ["tele-manas","icall"]
  humanHandoffOffered Boolean   @default(false) @map("human_handoff_offered")
  acknowledgedByUser  Boolean   @default(false) @map("acknowledged_by_user")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([riskLevel])
  @@map("risk_events")
}
