{
  "expo": {
    "name": "Nea",
    "slug": "nea-sih-mvp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Nea uses the camera for ISL / Video mode so it can track your face and hands while you sign."
      }
    },
    "android": {
      "package": "com.nea.sihmvp",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": ["CAMERA", "android.permission.CAMERA"]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Nea to use your camera for ISL / Video landmark tracking."
        }
      ]
    ]
  }
}
