{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend-node",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "backend/node-api", "run", "dev"],
      "port": 4000
    },
    {
      "name": "backend-risk",
